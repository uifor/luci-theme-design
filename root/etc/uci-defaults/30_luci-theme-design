#!/bin/sh

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" >/dev/null 2>&1; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.Design /luci-static/design

# Keep an existing theme active during upgrades. New installations select Design.
if [ "$PKG_UPGRADE" != 1 ] && [ "$changed" = 1 ]; then
		set_opt main.mediaurlbase /luci-static/design
fi

if [ "$changed" = 1 ]; then
	uci commit luci
fi

exit 0
